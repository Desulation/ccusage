<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Test names use Method_Scenario (CA1707); expected values are inline array literals (CA1861). -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <FakeEngineExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</FakeEngineExe>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FakeEnginePath" Value="$(MSBuildThisFileDirectory)../FakeEngine/bin/$(Configuration)/net10.0/ccusage$(FakeEngineExe)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ccusage.Mcp/Ccusage.Mcp.csproj" />
    <ProjectReference Include="../FakeEngine/FakeEngine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
